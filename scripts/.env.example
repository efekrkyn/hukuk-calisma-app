# Scripts — tek seferlik PDF yükleme ve gömme (embedding) işleri için.
# Bu dosyayı `.env` olarak kopyala. Günlük geliştirmede gerekmez; yalnızca
# kaynak PDF'leri yeniden yükleyecek ya da RAG indeksini yeniden kuracaksan.

# R2 (kaynak PDF deposu). Token kapsamı: Object Read & Write, yalnızca hukuk-pdf.
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hukuk-pdf

# Yüklenecek PDF'lerin bulunduğu yerel dizin.
SOURCE_DIR=

# Vectorize ve D1'e doğrudan yazan betikler için.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker'ın korumalı uçlarını betikten çağırmak için (worker'daki ile aynı).
ADMIN_SECRET=

# Toplu içerik üreten betikler için.
GEMINI_API_KEY=
