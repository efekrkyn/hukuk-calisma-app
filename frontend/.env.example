# Frontend — yerel geliştirme değişkenleri.
# Bu dosyayı `.env.local` olarak kopyala ve değerleri Efe'den al.
#
# ÜRETİMDE bu dosya kullanılmaz. Canlıdaki değerler Vercel proje ayarlarında
# (hukuk-efe → Settings → Environment Variables) durur.

# proxy.ts gelen oturum çerezindeki JWT'yi bununla doğruluyor.
# worker/.dev.vars içindeki ADMIN_SECRET ile BİREBİR AYNI olmak zorunda.
ADMIN_SECRET=

# Worker adresi. Boş bırakılırsa kod canlı worker'a düşer
# (https://hukuk-worker.efearas06.workers.dev).
# Yerel worker'a bağlanmak için: http://localhost:8787
NEXT_PUBLIC_WORKER_URL=
